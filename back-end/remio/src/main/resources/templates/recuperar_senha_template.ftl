<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Código</title>
</head>
<body style="margin:0; padding:0; background-color:#000000; width:100%; height:100%;">

    <table role="presentation" width="100%" height="100%" cellpadding="0" cellspacing="0" border="0"
        style="border-collapse:collapse; width:100%; height:100%;">
        <tr>
            <td align="center" valign="top" style="position:relative;">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                       style="border-collapse:collapse; width:100%; margin-top:30px;">
                    <tr>
                        <td align="left" style="padding-left:40px;">
                            <img src="https://i.ibb.co/vxxWyJF4/remio-logo-com-fundo-removebg-preview.png" alt="remio-logo-com-fundo-removebg-preview" width=130 style="display: block;" />

                        </td>
                        <td align="right" style="padding-right:40px;">
                            <img src="https://i.ibb.co/5hFnL2z2/bolinha-cortada-removebg-preview.png" alt="bolinha-cortada-removebg-preview" width="60 style="display:block;"/>

                            <img src="https://i.ibb.co/Q7gtwBKd/bolinha-sem-corte-removebg-preview.png" alt="bolinha-sem-corte-removebg-preview" width="40" style="display:block; margin-top:10px;"/>
                        </td>
                    </tr>
                </table>

                <!-- Mensagem central -->
                <table cellpadding="0" cellspacing="0" border="0" 
                       style="margin-top:120px; text-align:center;">
                    <tr>
                        <td align="center">
                            <h2 style="font-family: Arial, Helvetica, sans-serif; 
                                       font-size:22px; 
                                       color:#ffffff; 
                                       line-height:1.5; 
                                       margin:0;">
                                Aqui está seu código!!
                            </h2>
                        </td>
                    </tr>
                </table>

                <!-- Retângulo com o código -->
                <table cellpadding="0" cellspacing="0" border="0" style="margin-top:40px;">
                    <tr>
                        <td align="center">
                            <div style="
                                height:65px; 
                                width:210px; 
                                background-color:#5e17eb; 
                                border-radius:10px; 
                                color:white; 
                                font-family:Arial, Helvetica, sans-serif; 
                                font-size:22px; 
                                text-align:center; 
                                line-height:65px; 
                                font-weight:bold;">
                                ${codigo}
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Faixa inferior -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" 
                       style="border-collapse:collapse; background-color:#5e17eb; height:100px; margin-top:435px;">
                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>

</body>
</html>
